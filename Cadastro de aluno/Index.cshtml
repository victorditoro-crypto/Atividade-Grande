@model List<AlunosMVC.Models.Aluno>

<h1>Cadastro de Alunos</h1>

<table border="1">
    <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Idade</th>
        <th>Curso</th>
    </tr>

    @foreach (var aluno in Model)
    {
        <tr>
            <td>@aluno.Id</td>
            <td>@aluno.Nome</td>
            <td>@aluno.Idade</td>
            <td>@aluno.Curso</td>
        </tr>
    }
</table>