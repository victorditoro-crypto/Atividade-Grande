@model List<VeterinariaMVC.Models.Animal>

<h1>Clínica Veterinária</h1>

<p>
    <a href="/Veterinaria/Index">Todos</a> |
    <a href="/Veterinaria/Cachorros">Cachorros</a> |
    <a href="/Veterinaria/Gatos">Gatos</a>
</p>

<table border="1">
    <tr>
        <th>Nome</th>
        <th>Espécie</th>
        <th>Idade</th>
        <th>Dono</th>
    </tr>

    @foreach (var animal in Model)
    {
        <tr>
            <td>@animal.Nome</td>
            <td>@animal.Especie</td>
            <td>@animal.Idade</td>
            <td>@animal.Dono</td>
        </tr>
    }
</table>