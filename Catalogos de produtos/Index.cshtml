@model List<CatalogoMVC.Models.Produto>

<h1>Catálogo de Produtos</h1>

<table border="1">
    <tr>
        <th>Nome</th>
        <th>Categoria</th>
        <th>Estoque</th>
        <th>Preço</th>
        <th>Situação</th>
    </tr>

    @foreach (var produto in Model)
    {
        <tr>
            <td>@produto.Nome</td>
            <td>@produto.Categoria</td>
            <td>@produto.Estoque</td>
            <td>R$ @produto.Preco</td>
            <td>
                @(produto.Estoque == 0 ? "Produto esgotado" : "Disponível")
            </td>
        </tr>
    }
</table>

<a href="/Produto/Disponiveis">Ver produtos disponíveis</a>